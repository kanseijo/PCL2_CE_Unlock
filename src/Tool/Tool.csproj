<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <AssemblyName>PCL2_CE_Unlock</AssemblyName>
    <RootNamespace>PclCeUnlock.Tool</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <AssemblyTitle>PCL2_CE 解锁工具（第三方·非官方）</AssemblyTitle>
    <Version>1.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- 与注入版共用同一份解锁目标定义 -->
    <Compile Include="../Shared/UnlockTargets.cs" Link="Shared/UnlockTargets.cs" />
    <Compile Include="../Shared/LauncherProbe.cs" Link="Shared/LauncherProbe.cs" />
    <Compile Include="../Shared/DirectoryPolicy.cs" Link="Shared/DirectoryPolicy.cs" />
    <Compile Include="../Shared/Settings.cs" Link="Shared/Settings.cs" />
    <Compile Include="../Shared/ToolInfo.cs" Link="Shared/ToolInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.4.0" />
  </ItemGroup>
</Project>
